+ * 那个越界检查不是防御性编程,是必需的。KSU 注入规则时新增的 type 和 class
+ * 索引大于快照的 nprim,而 context_struct_compute_av() 开头就是:
+ *     sattr = flex_array_get(policydb->type_attr_map_array, scontext->type - 1);
+ *     BUG_ON(!sattr);
+ * 越界就是 NULL,就是 BUG_ON,就是 oops —— 手机变砖。所以宁可返回 -EINVAL
+ * 让调用方退回真实策略,也不能崩在这里。
+ */
+int selinux_clean_view_compute(u32 ssid, u32 tsid, u16 tclass,
+			       struct av_decision *avd)
+{
+	struct selinux_state *state = &selinux_state;
+	struct policydb *db;
+	struct context *scontext, *tcontext;
+	int ret = -EINVAL;
+
+	db = selinux_clean_view_db();
+	if (!db || !state->ss)
+		return -EAGAIN;
+	if (!state->initialized)
+		return -EOPNOTSUPP;
+
+	read_lock(&state->ss->policy_rwlock);
+
+	scontext = sidtab_search(state->ss->sidtab, ssid);
+	tcontext = sidtab_search(state->ss->sidtab, tsid);
+	if (!scontext || !tcontext)
+		goto out;
+
+	/* 快照里没有外部注入方新增的 type/class/role/user,越界会 BUG_ON。 */
+	if (scontext->type > db->p_types.nprim ||
+	    tcontext->type > db->p_types.nprim ||
+	    scontext->role > db->p_roles.nprim ||
+	    tcontext->role > db->p_roles.nprim ||
+	    scontext->user > db->p_users.nprim ||
+	    tcontext->user > db->p_users.nprim)
+		goto out;
+
+	/* 和 avd_init() 逐字段一致,只有 latest_granting 只能沿用真实值(见上)。 */
+	avd->allowed = 0;
+	avd->auditallow = 0;
+	avd->auditdeny = 0xffffffff;
+	avd->seqno = state->ss->latest_granting;
+	avd->flags = 0;
+
+	if (!tclass)
+		goto out;
+	if (tclass > db->p_classes.nprim)
+		goto out;
+
+	/* permissive 位看快照,不看真实策略。 */
+	if (ebitmap_get_bit(&db->permissive_map, scontext->type))
+		avd->flags |= AVD_FLAGS_PERMISSIVE;
+
+	context_struct_compute_av(db, scontext, tcontext, tclass, avd, NULL);
+	ret = 0;
+out:
+	read_unlock(&state->ss->policy_rwlock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(selinux_clean_view_compute);
