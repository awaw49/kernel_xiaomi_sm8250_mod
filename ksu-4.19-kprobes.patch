+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 干净策略视图 —— 4.19 上给 SELinux 补的"策略快照"能力。
+ *
+ * 用途:KSU 往运行中的策略里注入规则之后,外部通过 /sys/fs/selinux/access
+ * 查询、以及直接读 /sys/fs/selinux/policy,都能看到多出来的 type 和规则。
+ * 这个接口让调用方在注入【之前】抓一份原厂策略,之后用快照回答查询。
+ *
+ * 快照是重新解析出来的独立 policydb,不是指针拷贝;任何时候改真实策略都影响
+ * 不到它。实现见 security/selinux/clean_view.c。
+ *
+ * 本头文件在 security/selinux/ 之外也可见(ccflags-y 里有 -I.../include),
+ * 所以刻意不引用 struct policydb 的定义 —— 那个类型出了 security/selinux/
+ * 就看不见,这里只前置声明一个不透明指针。
+ */
+#ifndef _SELINUX_CLEAN_VIEW_H
+#define _SELINUX_CLEAN_VIEW_H
+
+#include <linux/types.h>
+#include <linux/errno.h>
+
+struct av_decision;
+struct policydb;
+
+#ifdef CONFIG_SECURITY_SELINUX
+
+/*
+ * 抓一份当前策略存成干净视图。必须在任何规则注入之前调用 —— 此刻导出的才是
+ * 原厂策略。重复调用是幂等的(第二次直接返回 0,不覆盖已有快照)。
+ *
+ * 返回 0 成功,负值失败;没开 SELinux 时返回 -EOPNOTSUPP。
+ */
+int selinux_clean_view_enable(void);
+
+/* 快照是否就绪。没就绪时调用方应当退回真实策略,而不是假装查询失败。 */
+bool selinux_clean_view_ready(void);
+
+/*
+ * 用快照算一次访问判定。SID 仍然走【真实】sidtab 解析(快照里没有 SID 表,
+ * 也不该有),但权限判定走快照的 avtab。
+ *
+ * 返回 0 并填好 avd;返回 -EAGAIN 表示快照没就绪、-EINVAL 表示这组 SID 或
+ * class 在原厂策略里不存在(KSU 注入的新 type 就是这种情况)—— 调用方在
+ * 这两种情况下应当退回真实策略,而不是报错。
+ *
+ * 注意这个函数【不能】替代真实判定来做实际 enforcement,只能用于回答外部
+ * 查询。它返回的 avd.auditdeny 等字段照样要按原样交给用户态。
+ */
+int selinux_clean_view_compute(u32 ssid, u32 tsid, u16 tclass,
+			       struct av_decision *avd);
+
+/*
+ * 以下两个只给 security/selinux/ 内部用(KSU 用不到),但必须留在头文件里 ——
+ * 定义在 clean_view.c,调用方分别是 ss/services.c 和 selinuxfs.c,不同编译单元。
+ *
+ * 返回的 policydb 指针在 enable() 之后既不改指向也不释放,调用方不需要持锁。
+ */
+struct policydb *selinux_clean_view_db(void);
+int selinux_clean_view_get_policy(void **data, size_t *len);
+
+#else /* !CONFIG_SECURITY_SELINUX */
+
+static inline int selinux_clean_view_enable(void)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline bool selinux_clean_view_ready(void)
+{
+	return false;
+}
+
+static inline int selinux_clean_view_compute(u32 ssid, u32 tsid, u16 tclass,
+					      struct av_decision *avd)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline struct policydb *selinux_clean_view_db(void)
+{
+	return NULL;
+}
+
+static inline int selinux_clean_view_get_policy(void **data, size_t *len)
+{
+	return -EOPNOTSUPP;
+}
