+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 干净策略视图 —— 捕获侧。
+ *
+ * 为什么必须是"导出 + 重新解析"而不是"拷贝一份 policydb":
+ *   struct policydb 里有 15 个左右指针字段(sym_val_to_name[SYM_NUM]、
+ *   class_val_to_struct、type_val_to_struct_array、type_attr_map_array、
+ *   filename_trans、te_cond_avtab、range_tr、genfs、ocontexts[OCON_NUM] …),
+ *   真正持有数据的是 flex_array 和 hashtab。规则注入路径 ksu_type()() 在把
+ *   type_attr_map_array / type_val_to_struct_array / sym_val_to_name[SYM_TYPES]
+ *   三个指针换到新对象之后,会对旧对象调 flex_array_free()。浅拷贝出来的这三块
+ *   和真实策略是同一块内存 —— 注入规则的那一刻就是 UAF,不是"有风险"。
+ *
+ *   而 security_read_policy() + policydb_read() 这条路是内核自己的序列化器和
+ *   解析器,走的是 kernel→kernel 的内存,不经过用户态。policydb_init() 先
+ *   memset 整个结构,再把 symtab / avtab / roles / cond_policydb / hashtab /
+ *   ebitmap 全部自己分配一遍,得到的 policydb 完全自洽,和真实策略零共享。
+ *   4.19 上这两个接口都是稳定的,policydb_read() 只做顺序读(内核格式),
+ *   不碰用户内存。
+ *
+ * 生命周期:快照在开机时抓一次,之后永久只读 —— clean_view_db 一旦发布就不再
+ * 改指向,也不释放。所以调用方拿到指针后不需要持锁,也不必担心失效。
+ * 代价是这份策略常驻内存(Mi 10 Ultra 上大约几百 KB 到 1 MB 多),换来的是
+ * 外部查询永远看不到后续注入。
+ */
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+#include <linux/compiler.h>
+
+#include "security.h"
+#include "clean_view.h"
+#include "ss/policydb.h"
+
+/* 干净策略自己的 policydb。见文件头:重新解析出来的,和真实策略零共享。 */
+static struct policydb *clean_view_db;
+
+/*
+ * 原厂策略的二进制导出,长期持有。
+ *
+ * security_read_policy() 返回的是 vmalloc_user 缓冲,而 selinuxfs 的
+ * sel_release_policy() 会对 plm->data 调 vfree() —— 所有权会打架。所以这里
+ * 换一份普通 vmalloc 的副本长期持有,和 selinuxfs 之间只走拷���。
+ *
+ * 它只被内核读(喂给 policydb_read),从不上映射给用户态,所以用 vmalloc
+ * 而不是 vmalloc_user 就够了。
+ */
+static void *clean_view_blob;
+static size_t clean_view_blob_len;
+
+/*
+ * 快照是否可用的发布标志。
+ *
+ * 写入只有 enable() 一处,而且是开机单线程;读的是 selinuxfs 的查询路径。
+ * 用 release/acquire 发布:看到 live==true 的读者一定能看到先写的 clean_view_db,
+ * 不会拿到"标志已置位但指针还是 NULL"的中间状态。
+ */
+static bool clean_view_live;
+
+static DEFINE_MUTEX(clean_view_lock);
+
+bool selinux_clean_view_ready(void)
+{
+	return smp_load_acquire(&clean_view_live);
+}
+EXPORT_SYMBOL_GPL(selinux_clean_view_ready);
+
+/*
+ * 抓一份当前策略。必须在 KSU 注入任何规则之前调用。
+ */
+int selinux_clean_view_enable(void)
+{
+	struct policy_file fp;
+	struct policydb *db;
+	void *blob, *kblob;
+	size_t len = 0;
+	int rc;
+
+	if (smp_load_acquire(&clean_view_live))
+		return 0;
+
+	/* 刻意不调 selinux_is_enabled():它在整棵树里只有 exports.c 里的定义,
+	 * include/security.h 没有给原型,调它就是隐式声明当 int 用,而实际返回
+	 * 类型是 bool。真正需要的"策略有没有初始化"判断,security_read_policy()
+	 * 开头自己就有(selinux_state.initialized 为假时返回 -EINVAL),直接让
+	 * 它判。 */
+	rc = security_read_policy(&selinux_state, &blob, &len);
+	if (rc)
+		return rc;
+	if (!blob || !len) {
+		vfree(blob);
+		return -EINVAL;
+	}
+
+	kblob = vmalloc(len);
+	if (!kblob) {
+		vfree(blob);
+		return -ENOMEM;
+	}
+	memcpy(kblob, blob, len);
+	vfree(blob);
+
+	db = kzalloc(sizeof(*db), GFP_KERNEL);
+	if (!db) {
+		vfree(kblob);
+		return -ENOMEM;
+	}
+
+	/*
+	 * policydb_read() 失败时,解析到一半已经分配出去的东西都挂在 db 上,
+	 * 必须走 policydb_destroy() 递归回收,直接 kfree 会漏一堆内存。
+	 * policydb_init() 是它内部调的,成功路径不用我们再初始化一次。
+	 */
+	fp.data = kblob;
+	fp.len = len;
+	rc = policydb_read(db, &fp);
+	if (rc) {
+		policydb_destroy(db);
+		kfree(db);
+		vfree(kblob);
+		return rc;
+	}
+
+	mutex_lock(&clean_view_lock);
+	if (clean_view_live) {
+		/* 并发的第二次调用:别人已经抓好了,丢掉自己这份。 */
+		mutex_unlock(&clean_view_lock);
+		policydb_destroy(db);
+		kfree(db);
+		vfree(kblob);
+		return 0;
+	}
+	clean_view_db = db;
+	clean_view_blob = kblob;
+	clean_view_blob_len = len;
+	/* release:上面三个指针的写必须先于 live 的写对读者可见。 */
+	smp_store_release(&clean_view_live, true);
+	mutex_unlock(&clean_view_lock);
+
+	pr_info("selinux: clean view captured: %zu bytes, %u types, %u classes, %u roles\n",
+		len, db->p_types.nprim, db->p_classes.nprim, db->p_roles.nprim);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(selinux_clean_view_enable);
+
+/*
+ * 给 ss/services.c 里的 selinux_clean_view_compute() 用。
+ *
+ * 不把 clean_view_db 做成非静态全局,是因为 struct policydb 在
+ * security/selinux/ 之外不可见,让外面的代码能直接持有这个类型的指针等于
+ * 把内核内部布局漏出去。compute() 被 static 的 context_struct_compute_av()
+ * 锁死在 services.c 里,而状态在这边 —— 这个窄接口就是这两者之间唯一的缝。
+ *
+ * 返回的是稳定指针:enable() 之后既不改指向也不释放,调用方不用持锁。
+ */
+struct policydb *selinux_clean_view_db(void)
+{
+	if (!smp_load_acquire(&clean_view_live))
+		return NULL;
+	return READ_ONCE(clean_view_db);
+}
+
+/*
+ * 给 selinuxfs 的 /sys/fs/selinux/policy 用:拿一份快照的拷贝。
+ *
+ * 必须拷 —— sel_release_policy() 会对 plm->data 做 vfree(),直接把长期持有的
+ * 指针交出去,用户态一次 close() 就把快照 free 掉了,第二次 open() 是 UAF。
+ *
+ * 拷贝用 vmalloc_user 而不是 vmalloc:这份缓冲会被 remap_vmalloc_range() 映射
+ * 进用户态,和 security_read_policy() 原本产出的缓冲性质保持一致。
+ *
+ * 返回 0 成功;快照没就绪返回 -EAGAIN,调用方退回 security_read_policy()。
+ */
+int selinux_clean_view_get_policy(void **data, size_t *len)
+{
+	void *buf;
+
+	if (!smp_load_acquire(&clean_view_live))
+		return -EAGAIN;
+
+	buf = vmalloc_user(clean_view_blob_len);
+	if (!buf)
+		return -ENOMEM;
+	memcpy(buf, clean_view_blob, clean_view_blob_len);
+
+	*data = buf;
+	*len = clean_view_blob_len;
+	return 0;
+}
