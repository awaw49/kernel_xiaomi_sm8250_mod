+/*
+ * KSU 4.19 适配:补一个 path_mount() 出口。
+ *
+ * 上游 KSU(infra/su_mount_ns.c)在 unshare(CLONE_NEWNS) 之后调
+ *     path_mount(NULL, &root_path, NULL, MS_PRIVATE | MS_REC, NULL);
+ * 把 root 及其整棵子树的挂载传播属性改成 private —— 目的是让它随后建的
+ * 挂载不会传播回宿主 mount namespace。
+ *
+ * cas 这棵树是 Android 的 4.19:没有 path_mount 这个导出入口,真正干活的
+ * do_change_type() 是 static,drivers/kernelsu/ 够不着。这里补一个同语义的
+ * 薄封装,KSU 侧的代码一行不用改。
+ *
+ * 刻意只实现 type_page == NULL 那一支:带 type_page 的真挂载要走 do_mount(),
+ * 它带着 security_sb_mount() 的 LSM 检查和各标志位拆分,不在这里重造一个
+ * 绕过 LSM 的版本。需要真挂载的调用点请直接用 ksys_mount()。
+ */
+int path_mount(const char *dev_name, struct path *path,
+	       const char *type_page, unsigned long flags, void *data_page)
+{
+	int err;
+
+	if (type_page)
+		return -EINVAL;
+	if (!(flags & (MS_SHARED | MS_PRIVATE | MS_SLAVE | MS_UNBINDABLE)))
+		return -EINVAL;
+
+	/* 和 do_mount() 走同一套 LSM/权限前置检查,顺序也照抄,
+	 * 否则这里就成了绕过 security_sb_mount() 的后门。
+	 * KSU 传进来的 dev_name / data 本来就是 NULL,
+	 * 和上游 path_mount() 走 do_mount() 时收到的是同一组 NULL。 */
+	err = security_sb_mount(dev_name, path, type_page, flags, data_page);
+	if (err)
+		return err;
+	if (!may_mount())
+		return -EPERM;
+	if (flags & SB_MANDLOCK) {
+		err = may_mandlock();
+		if (err)
+			return err;
+	}
+
+	return do_change_type(path, flags);
+}
+EXPORT_SYMBOL_GPL(path_mount);
