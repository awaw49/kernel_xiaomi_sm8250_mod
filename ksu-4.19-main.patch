+ */
+#ifndef strncpy_from_user_nofault
+static inline long strncpy_from_user_nofault(char *dst,
+					      const void __user *src,
+					      size_t count)
+{
+	long ret;
+
+	if (!count)
+		return 0;
+	ret = copy_from_user(dst, src, count);
